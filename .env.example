TOOL_PORT=8001

# Existing Upstream Microservices
USER_SERVICE_URL=http://localhost:8081
COURSE_SERVICE_URL=http://localhost:8082
ACTIVITY_SERVICE_URL=http://localhost:8083
ENROLLMENT_SERVICE_URL=http://localhost:8084
SETTINGS_SERVICE_URL=http://localhost:8084
PROGRESS_SERVICE_URL=http://localhost:8088
SERVICE_HTTP_TIMEOUT_SECONDS=2.5

# Optional AI LLM Insight Enrichment
GEMINI_API_KEY=
OPENAI_API_KEY=
RECOMMENDATION_ENABLE_LLM=true
RECOMMENDATION_LLM_TIMEOUT_SECONDS=4.0

# Recommendation DB (MySQL with automatic SQLite fallback)
RECOMMENDATION_DB_TYPE=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=recommendation_db
SQLITE_DB_PATH=./data/recommendation_db.sqlite

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
RECOMMENDATION_CACHE_TTL_SECONDS=900
